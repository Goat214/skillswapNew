# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard) to switch the app
# from demo mode (localStorage, no signup needed) to live mode.
#
# Leave this file as .env.example (or delete .env) to keep running in demo mode.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
